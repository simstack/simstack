            "DataSetSection": {
                "additionalProperties": false,
                "description": "Represents a section of a dataset containing tuples of models.\n\nA DataSetSection is a list of tuples where all tuples contain the same types of models.\nFor example, if one tuple contains (ModelA, ModelB), then all tuples in this section\nmust contain (ModelA, ModelB) instances.\n\n:ivar model_types: List of model class names that define the structure of each tuple.\n:type model_types: List[str]\n:ivar data: List of tuples, where each tuple contains model IDs corresponding to model_types.\n:type data: List[List[ObjectId]]",
                "properties": {
                    "model_types": {
                        "items": {
                            "type": "string"
                        },
                        "title": "Model Types",
                        "type": "array"
                    },
                    "data": {
                        "items": {
                            "items": {
                                "example": "5f85f36d6dfecacc68428a46",
                                "examples": [
                                    "5f85f36d6dfecacc68428a46",
                                    "ffffffffffffffffffffffff"
                                ],
                                "type": "string"
                            },
                            "type": "array"
                        },
                        "title": "Data",
                        "type": "array"
                    }
                },
                "title": "DataSetSection",
                "type": "object"
            }
        },
        "additionalProperties": false,
        "properties": {
            "name": {
                "default": "dataset",
                "title": "Name",
                "type": "string"
            },
            "metadata": {
